@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>LucroImpresso | Precificação e Gestão para Manufatura Aditiva</PageTitle>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/dashboard", forceLoad: true);
        }
    }
}

<!-- HERO SECTION NEO-BRUTALISTA -->
<section class="brutal-hero-section py-5">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 bg-white brutal-border px-3 py-1 mb-4 brutal-shadow">
                    <div class="status-dot-sm"></div>
                    <span class="font-headline text-xs font-black uppercase text-dark">GESTÃO E PRECIFICAÇÃO PARA IMPRESSÃO 3D</span>
                </div>
                
                <h1 class="font-headline display-3 fw-black text-dark mb-4 tracking-tight" tabindex="-1">
                    PRECIFICAÇÃO REAL <br>
                    <span class="bg-primary-container px-2 brutal-border-2 d-inline-block">SEM CHUTÔMETRO</span>
                </h1>
                
                <p class="font-body fs-5 text-dark fw-medium mb-4" style="max-width: 620px; line-height: 1.6;">
                    Transforme sua oficina de impressão 3D em um negócio rentável e previsível. 
                    Calcule centavo por centavo o custo real de matéria-prima, insumos de acabamento, consumo elétrico e horas de pós-processamento — gerando orçamentos profissionais em menos de 1 minuto.
                </p>

                <!-- 3 Pilares Rápidos no Hero -->
                <div class="row g-2 mb-4" style="max-width: 600px;">
                    <div class="col-sm-4">
                        <div class="p-2 bg-white brutal-border-2 text-center h-100">
                            <span class="material-symbols-outlined text-dark fs-5 d-block mb-1">scale</span>
                            <span class="font-headline text-xs font-bold text-dark d-block text-uppercase">Custo Real por Grama</span>
                            <small class="text-muted fw-semibold" style="font-size: 0.72rem;">Calculado por carretel</small>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="p-2 bg-white brutal-border-2 text-center h-100">
                            <span class="material-symbols-outlined text-dark fs-5 d-block mb-1">bolt</span>
                            <span class="font-headline text-xs font-bold text-dark d-block text-uppercase">Energia por Peça</span>
                            <small class="text-muted fw-semibold" style="font-size: 0.72rem;">Watts x Tarifa local</small>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="p-2 bg-white brutal-border-2 text-center h-100">
                            <span class="material-symbols-outlined text-dark fs-5 d-block mb-1">palette</span>
                            <span class="font-headline text-xs font-bold text-dark d-block text-uppercase">Pós-Proc. & Acabamento</span>
                            <small class="text-muted fw-semibold" style="font-size: 0.72rem;">Acabamento valorizado</small>
                        </div>
                    </div>
                </div>
                
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-yellow px-4 py-3 fs-5 brutal-shadow-lg text-uppercase fw-bold" href="login" data-enhance-nav="false">
                        <span class="material-symbols-outlined fs-4">rocket_launch</span>
                        ACESSAR PLATAFORMA
                    </a>
                    <a class="btn btn-white px-4 py-3 fs-5 text-uppercase fw-bold" href="#como-funciona">
                        <span class="material-symbols-outlined fs-4">explore</span>
                        COMO UTILIZAR
                    </a>
                </div>
            </div>
            
            <div class="col-lg-5">
                <!-- Card Hero Visual Neo-Brutalista: Demonstração Real do Cálculo -->
                <div class="bg-white brutal-border p-4 brutal-shadow-lg position-relative">
                    <div class="d-flex align-items-center justify-content-between pb-3 border-bottom brutal-border-b mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-dark fs-4">receipt_long</span>
                            <span class="font-headline fw-black text-dark uppercase fs-5">ORÇAMENTO INTELIGENTE</span>
                        </div>
                        <span class="badge bg-success text-white font-headline text-xs px-2 py-1">SIMULAÇÃO REAL</span>
                    </div>

                    <p class="font-body text-muted small mb-3 fw-semibold">
                        Veja a composição de preço calculada automaticamente pelo sistema:
                    </p>

                    <!-- Lista de Custos com Valores Visuais -->
                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="d-flex justify-content-between align-items-center p-2 bg-surface-container brutal-border-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined fs-5 text-dark">inventory_2</span>
                                <div>
                                    <span class="font-headline text-xs font-black text-dark d-block">FILAMENTO PLA (120g)</span>
                                    <small class="text-muted" style="font-size: 0.72rem;">R$ 110/kg = R$ 0,11/g</small>
                                </div>
                            </div>
                            <span class="font-headline fw-black text-dark fs-6">R$ 13,20</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-2 bg-surface-container brutal-border-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined fs-5 text-dark">palette</span>
                                <div>
                                    <span class="font-headline text-xs font-black text-dark d-block">VERNIZ / PRIMER (20ml)</span>
                                    <small class="text-muted" style="font-size: 0.72rem;">Acabamento detalhado</small>
                                </div>
                            </div>
                            <span class="font-headline fw-black text-dark fs-6">R$ 4,00</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-2 bg-surface-container brutal-border-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined fs-5 text-dark">bolt</span>
                                <div>
                                    <span class="font-headline text-xs font-black text-dark d-block">ENERGIA ELÉTRICA (5h)</span>
                                    <small class="text-muted" style="font-size: 0.72rem;">220W a R$ 0,85/kWh</small>
                                </div>
                            </div>
                            <span class="font-headline fw-black text-dark fs-6">R$ 0,94</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-2 bg-surface-container brutal-border-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined fs-5 text-dark">handyman</span>
                                <div>
                                    <span class="font-headline text-xs font-black text-dark d-block">MÃO DE OBRA (1h pós-processo)</span>
                                    <small class="text-muted" style="font-size: 0.72rem;">Lixamento e acabamento</small>
                                </div>
                            </div>
                            <span class="font-headline fw-black text-dark fs-6">R$ 25,00</span>
                        </div>
                    </div>

                    <!-- Bloco de Resultado Final -->
                    <div class="p-3 bg-primary-container brutal-border-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="font-headline text-xs font-bold text-dark uppercase">CUSTO TOTAL DE PRODUÇÃO:</span>
                            <span class="font-headline fw-black text-dark">R$ 43,14</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top border-dark">
                            <div>
                                <span class="font-headline text-xs font-black text-dark d-block text-uppercase">VALOR DE VENDA SUGERIDO</span>
                                <small class="fw-bold text-dark" style="font-size: 0.72rem;">Com margem de 100% de lucro</small>
                            </div>
                            <span class="font-headline fw-black text-dark display-6 mb-0" style="font-size: 1.8rem;">R$ 86,28</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SEÇÃO DE RECURSOS E SOLUÇÕES -->
<section id="recursos" class="py-5 bg-white brutal-border-t">
    <div class="container py-4">
        <header class="text-center mb-5">
            <div class="d-inline-flex align-items-center gap-2 bg-surface-container brutal-border px-3 py-1 mb-2">
                <span class="material-symbols-outlined text-dark fs-5">stars</span>
                <span class="font-headline text-xs font-black uppercase text-dark">RECURSOS DESENVOLVIDOS PARA MAKERS</span>
            </div>
            <h2 class="font-headline display-5 fw-black text-dark uppercase tracking-tight">
                TUDO O QUE SUA OFICINA PRECISA
            </h2>
            <p class="font-body fs-5 text-dark fw-medium" style="max-width: 700px; margin: 0 auto;">
                Acabe com o tempo perdido em planilhas confusas e anotações soltas. O Lucro Impresso reúne todas as etapas da sua operação em um único painel.
            </p>
        </header>

        <div class="row g-4">
            <!-- Card 1: Filamentos & Resinas -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 bg-surface-container brutal-border h-100 brutal-shadow d-flex flex-column">
                    <div class="p-3 bg-white brutal-border-2 d-inline-flex align-items-center justify-content-center mb-3" style="width: 54px; height: 54px;">
                        <span class="material-symbols-outlined fs-2 text-dark">inventory_2</span>
                    </div>
                    <h4 class="font-headline fs-5 fw-black text-dark uppercase mb-2">Controle de Filamentos</h4>
                    <p class="font-body text-dark mb-3 fw-medium" style="line-height: 1.5;">
                        Cadastre seus carretéis com peso e valor pago. O sistema descobre a fração exata de cada grama e gerencia o saldo disponível conforme as peças são produzidas.
                    </p>
                    <div class="mt-auto pt-2 border-top brutal-border-t">
                        <span class="text-dark small fw-bold font-headline">✓ Sem carretel vazio de surpresa</span>
                    </div>
                </div>
            </div>

            <!-- Card 2: Tintas e Acabamento -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 bg-surface-container brutal-border h-100 brutal-shadow d-flex flex-column">
                    <div class="p-3 bg-white brutal-border-2 d-inline-flex align-items-center justify-content-center mb-3" style="width: 54px; height: 54px;">
                        <span class="material-symbols-outlined fs-2 text-dark">palette</span>
                    </div>
                    <h4 class="font-headline fs-5 fw-black text-dark uppercase mb-2">Gestão de Acabamento</h4>
                    <p class="font-body text-dark mb-3 fw-medium" style="line-height: 1.5;">
                        Se você realiza pós-processamento, sabe que tintas, primers e vernizes têm custo elevado. O sistema calcula o preço por mililitro e desconta os volumes usados em cada encomenda.
                    </p>
                    <div class="mt-auto pt-2 border-top brutal-border-t">
                        <span class="text-dark small fw-bold font-headline">✓ Insumos de acabamento contabilizados</span>
                    </div>
                </div>
            </div>

            <!-- Card 3: Eletricidade e Máquinas -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 bg-surface-container brutal-border h-100 brutal-shadow d-flex flex-column">
                    <div class="p-3 bg-white brutal-border-2 d-inline-flex align-items-center justify-content-center mb-3" style="width: 54px; height: 54px;">
                        <span class="material-symbols-outlined fs-2 text-dark">precision_manufacturing</span>
                    </div>
                    <h4 class="font-headline fs-5 fw-black text-dark uppercase mb-2">Energia das Impressoras</h4>
                    <p class="font-body text-dark mb-3 fw-medium" style="line-height: 1.5;">
                        Cadastre cada impressora com seu consumo em Watts e a tarifa da sua conta de luz. Cada hora de impressão é calculada com exatidão no custo da peça.
                    </p>
                    <div class="mt-auto pt-2 border-top brutal-border-t">
                        <span class="text-dark small fw-bold font-headline">✓ Sem sustos na conta de luz</span>
                    </div>
                </div>
            </div>

            <!-- Card 4: Clientes & Catálogo STL -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 bg-surface-container brutal-border h-100 brutal-shadow d-flex flex-column">
                    <div class="p-3 bg-white brutal-border-2 d-inline-flex align-items-center justify-content-center mb-3" style="width: 54px; height: 54px;">
                        <span class="material-symbols-outlined fs-2 text-dark">folder_shared</span>
                    </div>
                    <h4 class="font-headline fs-5 fw-black text-dark uppercase mb-2">Clientes e Arquivos STL</h4>
                    <p class="font-body text-dark mb-3 fw-medium" style="line-height: 1.5;">
                        Centralize dados de clientes (CPF, CNPJ e endereços para entrega) e guarde links de arquivos 3D. Quando o cliente solicitar uma nova cópia, o orçamento já está pronto.
                    </p>
                    <div class="mt-auto pt-2 border-top brutal-border-t">
                        <span class="text-dark small fw-bold font-headline">✓ Histórico comercial completo</span>
                    </div>
                </div>
            </div>

            <!-- Card 5: Linha de Produção Inteligente -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 bg-surface-container brutal-border h-100 brutal-shadow d-flex flex-column">
                    <div class="p-3 bg-white brutal-border-2 d-inline-flex align-items-center justify-content-center mb-3" style="width: 54px; height: 54px;">
                        <span class="material-symbols-outlined fs-2 text-dark">table_rows</span>
                    </div>
                    <h4 class="font-headline fs-5 fw-black text-dark uppercase mb-2">Linha de Produção</h4>
                    <p class="font-body text-dark mb-3 fw-medium" style="line-height: 1.5;">
                        Acompanhe o andamento dos pedidos: de pendente até a entrega final. A baixa de material no estoque é efetuada de forma inteligente apenas quando a peça é concluída.
                    </p>
                    <div class="mt-auto pt-2 border-top brutal-border-t">
                        <span class="text-dark small fw-bold font-headline">✓ Estoque sempre sincronizado</span>
                    </div>
                </div>
            </div>

            <!-- Card 6: Dashboard Financeiro -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 bg-primary-container brutal-border h-100 brutal-shadow d-flex flex-column">
                    <div class="p-3 bg-white brutal-border-2 d-inline-flex align-items-center justify-content-center mb-3" style="width: 54px; height: 54px;">
                        <span class="material-symbols-outlined fs-2 text-dark">monitoring</span>
                    </div>
                    <h4 class="font-headline fs-5 fw-black text-dark uppercase mb-2">Lucro Líquido Real</h4>
                    <p class="font-body text-dark mb-3 fw-medium" style="line-height: 1.5;">
                        Descubra exatamente quanto sobrou limpo no seu caixa. Visualize vendas totais, gastos separados com materiais, acabamentos e energia, além de alertas de reposição de estoque.
                    </p>
                    <div class="mt-auto pt-2 border-top border-dark">
                        <span class="text-dark small fw-bold font-headline">✓ Engenharia financeira transparente</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SEÇÃO COMO FUNCIONA (PASSO A PASSO DIDÁTICO) -->
<section id="como-funciona" class="py-5 bg-surface-container brutal-border-t brutal-border-b">
    <div class="container py-4">
        <header class="text-center mb-5">
            <div class="d-inline-flex align-items-center gap-2 bg-white brutal-border px-3 py-1 mb-2">
                <span class="material-symbols-outlined text-dark fs-5">play_circle</span>
                <span class="font-headline text-xs font-black uppercase text-dark">PASSO A PASSO SIMPLES</span>
            </div>
            <h2 class="font-headline display-5 fw-black text-dark uppercase tracking-tight">
                COMO UTILIZAR NA SUA ROTINA
            </h2>
            <p class="font-body fs-5 text-dark fw-medium" style="max-width: 700px; margin: 0 auto;">
                Veja como é fácil transformar uma ideia em um orçamento perfeito e lucrativo em 4 etapas diretas.
            </p>
        </header>

        <div class="d-flex flex-column gap-4 max-w-4xl mx-auto" style="max-width: 920px; margin: 0 auto;">
            <!-- Passo 1 -->
            <div class="step-card bg-white brutal-border d-flex align-items-stretch overflow-hidden brutal-shadow">
                <div class="bg-dark text-white p-4 d-flex align-items-center justify-content-center brutal-border-r" style="min-width: 85px;">
                    <span class="font-headline display-5 fw-black text-white">1</span>
                </div>
                <div class="p-4 flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-warning text-dark font-headline text-xs">CONFIGURAÇÃO INICIAL</span>
                    </div>
                    <h3 class="font-headline fs-4 fw-black text-dark uppercase tracking-wide mb-2">CADASTRE SUA ESTRUTURA (MÁQUINAS E INSUMOS)</h3>
                    <p class="font-body text-dark mb-0 fw-medium" style="line-height: 1.6;">
                        Cadastre suas impressoras 3D informando a potência em Watts e o valor do kWh da sua conta de luz. Em seguida, adicione seus carretéis de filamento, resinas e insumos de acabamento com os preços de compra. Você faz isso uma única vez e o sistema passa a calcular o custo de cada fração automaticamente.
                    </p>
                </div>
                <div class="bg-surface p-4 d-none d-md-flex align-items-center justify-content-center brutal-border-l" style="min-width: 95px;">
                    <span class="material-symbols-outlined fs-1 text-dark">tune</span>
                </div>
            </div>

            <!-- Passo 2 -->
            <div class="step-card bg-white brutal-border d-flex align-items-stretch overflow-hidden brutal-shadow">
                <div class="bg-dark text-white p-4 d-flex align-items-center justify-content-center brutal-border-r" style="min-width: 85px;">
                    <span class="font-headline display-5 fw-black text-white">2</span>
                </div>
                <div class="p-4 flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-dark text-white font-headline text-xs">CATÁLOGO ORGANIZADO</span>
                    </div>
                    <h3 class="font-headline fs-4 fw-black text-dark uppercase tracking-wide mb-2">REGISTRE SEUS CLIENTES E PEÇAS</h3>
                    <p class="font-body text-dark mb-0 fw-medium" style="line-height: 1.6;">
                        Mantenha um cadastro dos seus clientes para gerar propostas formais e salvar os endereços de entrega. Cadastre as peças recorrentes e salve os links dos arquivos STL, evitando a bagunça de ter que fatiar tudo novamente toda vez que um cliente pedir outra unidade.
                    </p>
                </div>
                <div class="bg-surface p-4 d-none d-md-flex align-items-center justify-content-center brutal-border-l" style="min-width: 95px;">
                    <span class="material-symbols-outlined fs-1 text-dark">group_add</span>
                </div>
            </div>

            <!-- Passo 3 -->
            <div class="step-card bg-primary-container brutal-border d-flex align-items-stretch overflow-hidden brutal-shadow">
                <div class="bg-dark text-white p-4 d-flex align-items-center justify-content-center brutal-border-r" style="min-width: 85px;">
                    <span class="font-headline display-5 fw-black text-white">3</span>
                </div>
                <div class="p-4 flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-dark text-white font-headline text-xs">PRECIFICAÇÃO EM SEGUNDOS</span>
                    </div>
                    <h3 class="font-headline fs-4 fw-black text-dark uppercase tracking-wide mb-2">MONTE O ORÇAMENTO COM OS DADOS DO FATIADOR</h3>
                    <p class="font-body text-dark mb-0 fw-medium" style="line-height: 1.6;">
                        Abra a tela de orçamento, escolha a máquina e o material, e digite o peso em gramas e as horas estimadas pelo fatiador. Se tiver pós-processamento, adicione os insumos de acabamento e as horas de mão de obra. O sistema cruza tudo, verifica se há estoque suficiente para não deixar você na mão e sugere o valor de venda ideal.
                    </p>
                </div>
                <div class="bg-white p-4 d-none d-md-flex align-items-center justify-content-center brutal-border-l" style="min-width: 95px;">
                    <span class="material-symbols-outlined fs-1 text-dark">calculate</span>
                </div>
            </div>

            <!-- Passo 4 -->
            <div class="step-card bg-white brutal-border d-flex align-items-stretch overflow-hidden brutal-shadow">
                <div class="bg-dark text-white p-4 d-flex align-items-center justify-content-center brutal-border-r" style="min-width: 85px;">
                    <span class="font-headline display-5 fw-black text-white">4</span>
                </div>
                <div class="p-4 flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-success text-white font-headline text-xs">CONTROLE TOTAL</span>
                    </div>
                    <h3 class="font-headline fs-4 fw-black text-dark uppercase tracking-wide mb-2">PRODUZA COM SEGURANÇA E VEJA O LUCRO LÍQUIDO</h3>
                    <p class="font-body text-dark mb-0 fw-medium" style="line-height: 1.6;">
                        Inicie o trabalho alterando o status para 'Em Impressão'. Ao terminar, marque como 'Concluído': o sistema dá baixa imediata nos gramas de filamento e mililitros de acabamento utilizados. No Dashboard, acompanhe a saúde do seu negócio com métricas claras de receitas, despesas e lucro real no bolso.
                    </p>
                </div>
                <div class="bg-surface p-4 d-none d-md-flex align-items-center justify-content-center brutal-border-l" style="min-width: 95px;">
                    <span class="material-symbols-outlined fs-1 text-dark">point_of_sale</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- BENEFÍCIOS SECTION -->
<section id="beneficios" class="py-5 bg-white">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h2 class="font-headline display-5 fw-black text-dark mb-4 tracking-tight uppercase">
                    PARE DE PERDER <span class="bg-primary-container px-2 brutal-border-2">DINHEIRO</span>
                </h2>
                <p class="font-body fs-5 text-dark mb-4 fw-medium" style="line-height: 1.6;">
                    A maioria dos makers precifica peças baseando-se no "achismo" ou apenas multiplicando o custo do material por 3. Isso ignora o desgaste da máquina, eletricidade, mão de obra e eventuais perdas por falha.
                </p>
                
                <div class="d-flex flex-column gap-3">
                    <div class="p-3 bg-surface brutal-border-2 d-flex align-items-center gap-3">
                        <span class="material-symbols-outlined text-dark fs-3 font-bold">check_box</span>
                        <span class="font-headline fs-5 text-dark fw-bold uppercase">Precisão milimétrica no custo da grama gasta</span>
                    </div>
                    <div class="p-3 bg-surface brutal-border-2 d-flex align-items-center gap-3">
                        <span class="material-symbols-outlined text-dark fs-3 font-bold">check_box</span>
                        <span class="font-headline fs-5 text-dark fw-bold uppercase">Alertas proativos de estoque para evitar atrasos</span>
                    </div>
