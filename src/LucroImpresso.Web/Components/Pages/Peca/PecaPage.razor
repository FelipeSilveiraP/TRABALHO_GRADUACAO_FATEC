@page "/pecas"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using LucroImpresso.Web.Models
@using LucroImpresso.Web.Interfaces
@using LucroImpresso.Web.Services
@inject IPecaRepository PecaRepo
@inject UsuarioContextService UsuarioCtx
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>LucroImpresso | Peças</PageTitle>

<div class="page-container" style="max-width: 1300px; margin: 0 auto; padding: 1.25rem 1.5rem;">
    <header class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 pb-3 brutal-border-b">
        <div>
            <div class="d-inline-flex align-items-center gap-2 bg-white brutal-border-2 px-3 py-1 mb-2">
                <span class="material-symbols-outlined text-dark fs-5">view_in_ar</span>
                <span class="font-headline text-xs font-black uppercase text-dark">CATÁLOGO DE MODELOS</span>
            </div>
            <h1 class="font-headline text-dark fw-black mb-0 display-6 uppercase tracking-tight">GESTÃO DE PEÇAS</h1>
            <p class="font-body text-muted fs-6 mt-1 mb-0 fw-semibold">Cadastre modelos 3D, referências técnicas e links diretos para arquivos STL.</p>
        </div>
    </header>

    @if (erroCarregamento)
    {
        <div class="alert alert-danger mb-4">
            <span class="material-symbols-outlined me-2 fs-5">error</span>
            Falha na conexão com o banco de dados. Verifique o serviço SQL.
        </div>
    }

    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-danger mb-4">
            <span class="material-symbols-outlined me-2 fs-5">error</span>
            @mensagemErro
        </div>
    }

    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert alert-success mb-4">
            <span class="material-symbols-outlined me-2 fs-5">check_circle</span>
            @mensagemSucesso
        </div>
    }

    <!-- Formulário Master-Detail Neo-Brutalista -->
    <div class="bg-white brutal-border p-4 p-md-5 mb-5 brutal-shadow-lg">
        <div class="d-flex align-items-center justify-content-between pb-3 border-bottom brutal-border-b mb-4">
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-dark fs-3">extension</span>
                <h3 class="font-headline fw-black text-dark uppercase mb-0 fs-4">
                    @(modoEdicao ? "EDITAR PEÇA" : "CADASTRAR NOVA PEÇA")
                </h3>
            </div>
            @if (modoEdicao)
            {
                <span class="badge bg-warning text-dark">MODO EDIÇÃO</span>
            }
        </div>

        <EditForm Model="@formularioPeca" OnValidSubmit="SalvarPeca" FormName="formPeca">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small mb-3 fw-bold font-headline" />

            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label text-dark">Nome da Peça / Modelo</label>
                    <InputText @bind-Value="formularioPeca.NomePeca"
                               class="form-control"
                               placeholder="Ex: Suporte Articulado Headset"
                               maxlength="200" />
                    <ValidationMessage For="@(() => formularioPeca.NomePeca)" class="text-danger fw-bold small" />
                </div>
                <div class="col-md-5">
                    <label class="form-label text-dark">Link do Arquivo STL (Opcional)</label>
                    <InputText @bind-Value="formularioPeca.LinkArquivoStl"
                               class="form-control"
                               placeholder="https://cloud.maker.com/model.stl"
                               maxlength="2000" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-yellow w-100 py-3 fs-6" disabled="@carregando">
                        @if (carregando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>AGUARDE...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined fs-5">@(modoEdicao ? "save" : "add_circle")</span>
                            @((modoEdicao ? "ATUALIZAR" : "SALVAR"))
                        }
                    </button>
                </div>
            </div>

            @if (modoEdicao)
            {
                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-outline-danger py-2 px-4" @onclick="CancelarEdicao">
                        ✕ CANCELAR EDIÇÃO
                    </button>
                </div>
            }
        </EditForm>
    </div>

    <!-- Tabela de Peças Neo-Brutalista -->
    <div class="bg-white brutal-border p-4 brutal-shadow-lg">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom brutal-border-b">
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-dark fs-4">category</span>
                <h4 class="font-headline fw-black text-dark uppercase mb-0 fs-5">PEÇAS CADASTRADAS</h4>
            </div>
            <span class="badge bg-warning text-dark">@(pecas.Count) MODELOS</span>
        </div>

        @if (carregando && !pecas.Any())
        {
            <div class="text-center py-5">
                <div class="spinner-border text-dark" role="status"></div>
                <p class="font-headline text-dark fw-bold mt-2 uppercase">Sincronizando catálogo...</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table brutal-table text-dark mb-0">
                    <thead>
                        <tr>
                            <th>NOME DA PEÇA</th>
                            <th>ARQUIVO STL / MODELO</th>
                            <th class="text-center">AÇÕES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!pecas.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4 font-headline fw-bold">Nenhuma peça cadastrada no momento.</td></tr>
                        }
                        else
                        {
                            @foreach (var p in pecas)
                            {
                                <tr>
                                    <td><strong class="font-headline text-dark fs-6">@p.NomePeca</strong></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.LinkArquivoStl))
                                        {
                                            <a href="@p.LinkArquivoStl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm">
                                                <span class="material-symbols-outlined fs-6">link</span>
                                                ACESSAR STL ↗
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted fw-semibold">— Sem link —</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button class="btn btn-outline-warning btn-sm" @onclick="() => EditarPeca(p)">
                                                <span class="material-symbols-outlined fs-6">edit</span>
                                                Editar
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ExcluirPeca(p.Id)">
                                                <span class="material-symbols-outlined fs-6">delete</span>
                                                Excluir
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<Peca> pecas = new();
    private Peca formularioPeca = new();
    private bool modoEdicao = false;
    private bool carregando = false;
    private bool erroCarregamento = false;
    private string? mensagemSucesso;
    private string? mensagemErro;
    private int usuarioId = 0;

    protected override async Task OnInitializedAsync()
    {
        usuarioId = await UsuarioCtx.GetUsuarioIdAsync();
        carregando = true;
        try
        {
            await CarregarPecas();
        }
        catch (Exception)
        {
            erroCarregamento = true;
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task CarregarPecas()
    {
        pecas = await PecaRepo.GetAllAsync(usuarioId);
    }

    private async Task SalvarPeca()
    {
        mensagemSucesso = null;
        mensagemErro = null;

        if (!string.IsNullOrWhiteSpace(formularioPeca.LinkArquivoStl))
        {
            if (!Uri.TryCreate(formularioPeca.LinkArquivoStl, UriKind.Absolute, out var uriResult)
                || (uriResult.Scheme != Uri.UriSchemeHttp && uriResult.Scheme != Uri.UriSchemeHttps))
            {
                mensagemErro = "O link do arquivo STL deve ser uma URL válida iniciando com http:// ou https://.";
                return;
            }
        }

        carregando = true;
        try
        {
            if (modoEdicao && formularioPeca.Id > 0)
            {
                formularioPeca.UsuarioId = usuarioId;
                await PecaRepo.UpdateAsync(formularioPeca);
                mensagemSucesso = "Peça atualizada com sucesso!";
            }
            else
            {
                formularioPeca.UsuarioId = usuarioId;
                await PecaRepo.AddAsync(formularioPeca);
                mensagemSucesso = "Peça cadastrada com sucesso!";
            }

            formularioPeca = new Peca();
            modoEdicao = false;
            await CarregarPecas();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao salvar peça: {ex.Message}");
            erroCarregamento = true;
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private void EditarPeca(Peca p)
    {
        formularioPeca = new Peca
        {
            Id = p.Id,
            UsuarioId = p.UsuarioId,
            NomePeca = p.NomePeca,
            LinkArquivoStl = p.LinkArquivoStl
        };
        modoEdicao = true;
        mensagemSucesso = null;
    }

    private void CancelarEdicao()
    {
        formularioPeca = new Peca();
        modoEdicao = false;
    }

    private async Task ExcluirPeca(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "Você deseja realmente excluir esta peça?");
        if (confirmado)
        {
            mensagemErro = null;
            mensagemSucesso = null;
            try
            {
                await PecaRepo.DeleteAsync(id, usuarioId);
            }
            catch (InvalidOperationException ex)
            {
                // Peça em uso por orçamentos (FK RESTRICT): exibe aviso em vez de derrubar a tela
                mensagemErro = ex.Message;
            }
            await CarregarPecas();
            StateHasChanged();
        }
    }
}
