@page "/material"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using LucroImpresso.Web.Models
@using LucroImpresso.Web.Interfaces
@using LucroImpresso.Web.Services
@inject IMaterialRepository MaterialRepo
@inject UsuarioContextService UsuarioCtx
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>LucroImpresso | Material</PageTitle>

<div class="page-container" style="max-width: 1300px; margin: 0 auto; padding: 1.25rem 1.5rem;">
    <header class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 pb-3 brutal-border-b">
        <div>
            <div class="d-inline-flex align-items-center gap-2 bg-white brutal-border-2 px-3 py-1 mb-2">
                <span class="material-symbols-outlined text-dark fs-5">inventory_2</span>
                <span class="font-headline text-xs font-black uppercase text-dark">ESTOQUE DE FILAMENTOS E RESINAS</span>
            </div>
            <h1 class="font-headline text-dark fw-black mb-0 display-6 uppercase tracking-tight">GESTÃO DE MATERIAIS</h1>
            <p class="font-body text-muted fs-6 mt-1 mb-0 fw-semibold">Controle master-detail de insumos, cálculo do valor por grama (RN001) e saldo disponível.</p>
        </div>
    </header>

    @if (erroCarregamento)
    {
        <div class="alert alert-danger mb-4">
            <span class="material-symbols-outlined me-2 fs-5">error</span>
            Falha na conexão com o banco de dados. Verifique o serviço SQL.
        </div>
    }

    @if (!string.IsNullOrEmpty(mensagemExclusao))
    {
        <div class="alert alert-danger mb-4">
            <span class="material-symbols-outlined me-2 fs-5">error</span>
            @mensagemExclusao
        </div>
    }

    <!-- Topo: Master-Detail Form Neo-Brutalista -->
    <div class="bg-white brutal-border p-4 p-md-5 mb-5 brutal-shadow-lg">
        <div class="d-flex align-items-center justify-content-between pb-3 border-bottom brutal-border-b mb-4">
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-dark fs-3">inventory_2</span>
                <h3 class="font-headline fw-black text-dark uppercase mb-0 fs-4">
                    @(modoEdicao ? "EDITAR MATERIAL" : "CADASTRAR NOVO MATERIAL")
                </h3>
            </div>
            @if (modoEdicao)
            {
                <span class="badge bg-warning text-dark">MODO EDIÇÃO</span>
            }
        </div>
        
        <EditForm Model="@formularioMaterial" OnValidSubmit="SalvarMaterial" FormName="formMaterial">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small mb-3 fw-bold font-headline" />
            
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label text-dark">Nome do Material</label>
                    <InputText @bind-Value="formularioMaterial.Nome" class="form-control" placeholder="Ex: PLA Premium Preto" maxlength="100" />
                    <ValidationMessage For="@(() => formularioMaterial.Nome)" class="text-danger fw-bold small" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-dark">Peso do Rolo</label>
                    <div class="input-group">
                        <input type="text" 
                               class="form-control" 
                               placeholder="Ex: 1000" 
                               oninput="window.masks.weight(this)"
                               @onchange="UpdatePeso"
                               value="@pesoFormatted"
                               maxlength="10" />
                        <span class="input-group-text">g</span>
                    </div>
                    <ValidationMessage For="@(() => formularioMaterial.PesoRoloGramas)" class="text-danger fw-bold small" />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-dark">Saldo Atual</label>
                    <div class="input-group">
                        <input type="text" 
                               class="form-control" 
                               placeholder="Ex: 850,00" 
                               oninput="window.masks.weightUnit(this)"
                               @onchange="UpdateSaldo"
                               value="@saldoFormatted"
                               maxlength="10" />
                        <span class="input-group-text">g</span>
                    </div>
                    <ValidationMessage For="@(() => formularioMaterial.SaldoGramas)" class="text-danger fw-bold small" />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-dark">Valor Pago</label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input type="text" 
                               class="form-control" 
                               placeholder="Ex: 85,00" 
                               oninput="window.masks.money(this)"
                               @onchange="UpdateValorPago"
                               value="@valorPagoFormatted"
                               maxlength="10" />
                    </div>
                    <ValidationMessage For="@(() => formularioMaterial.ValorPago)" class="text-danger fw-bold small" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-yellow w-100 py-3 fs-6" disabled="@carregando">
                        @if (carregando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>AGUARDE...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined fs-5">@(modoEdicao ? "save" : "add_circle")</span>
                            @((modoEdicao ? "ATUALIZAR" : "SALVAR"))
                        }
                    </button>
                </div>
            </div>
            @if (modoEdicao)
            {
                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-outline-danger py-2 px-4" @onclick="CancelarEdicao">
                        ✕ CANCELAR EDIÇÃO
                    </button>
                </div>
            }
        </EditForm>
    </div>

    <!-- Base: Tabela de Materiais -->
    <div class="bg-white brutal-border p-4 brutal-shadow-lg">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom brutal-border-b">
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-dark fs-4">layers</span>
                <h4 class="font-headline fw-black text-dark uppercase mb-0 fs-5">MATERIAIS NO ESTOQUE</h4>
            </div>
            <span class="badge bg-warning text-dark">@(materiais.Count) MATERIAIS</span>
        </div>

        @if (carregando && !materiais.Any())
        {
            <div class="text-center py-5">
                <div class="spinner-border text-dark" role="status"></div>
                <p class="font-headline text-dark fw-bold mt-2 uppercase">Sincronizando banco de dados...</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table brutal-table text-dark mb-0">
                    <thead>
                        <tr>
                            <th>DATA CADASTRO</th>
                            <th>NOME DO MATERIAL</th>
                            <th>PESO ORIGINAL</th>
                            <th>SALDO ATUAL</th>
                            <th>VALOR PAGO</th>
                            <th>PREÇO / GRAMA</th>
                            <th class="text-center">AÇÕES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (materiais == null)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4 font-headline fw-bold">Carregando o sistema...</td></tr>
                        }
                        else if (!materiais.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4 font-headline fw-bold">Nenhum material cadastrado no momento.</td></tr>
                        }
                        else
                        {
                            @foreach (var mat in materiais)
                            {
                                <tr>
                                    <td><span class="font-body text-dark fw-semibold">@mat.DataCadastro.ToString("dd/MM/yyyy")</span></td>
                                    <td><strong class="font-headline text-dark fs-6">@mat.Nome</strong></td>
                                    <td><span class="font-body text-dark fw-bold">@mat.PesoRoloGramas.ToString("N2") g</span></td>
                                    <td>
                                        @if (mat.SaldoGramas <= (mat.PesoRoloGramas * 0.2m))
                                        {
                                            <span class="badge bg-danger text-white">⚠ @mat.SaldoGramas.ToString("N2") g</span>
                                        }
                                        else if (mat.SaldoGramas <= (mat.PesoRoloGramas * 0.5m))
                                        {
                                            <span class="badge bg-warning text-dark">⚠ @mat.SaldoGramas.ToString("N2") g</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary text-white">@mat.SaldoGramas.ToString("N2") g</span>
                                        }
                                    </td>
                                    <td><span class="font-body text-dark fw-semibold">@mat.ValorPago.ToString("C2")</span></td>
                                    <td><strong class="font-headline text-dark fs-6">@mat.PrecoPorGrama.ToString("C2") / g</strong></td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button class="btn btn-outline-warning btn-sm" @onclick="() => EditarMaterial(mat)">
                                                <span class="material-symbols-outlined fs-6">edit</span>
                                                Editar
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ExcluirMaterial(mat.Id)">
                                                <span class="material-symbols-outlined fs-6">delete</span>
                                                Excluir
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private string? mensagemExclusao;
    private List<Material> materiais = new();
    private Material formularioMaterial = new();
    private bool erroCarregamento = false;
    private bool modoEdicao = false;
    private bool carregando = false;
    private int usuarioId = 0;

    private string pesoFormatted = "";
    private string saldoFormatted = "";
    private string valorPagoFormatted = "";

    private void UpdatePeso(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        pesoFormatted = val;
        var clean = val.Replace(".", "").Replace(",", ".");
        if (decimal.TryParse(clean, System.Globalization.CultureInfo.InvariantCulture, out decimal res))
            formularioMaterial.PesoRoloGramas = Math.Max(0, res);
    }

    private void UpdateSaldo(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        saldoFormatted = val;
        var clean = val.Replace(".", "").Replace(",", ".");
        if (decimal.TryParse(clean, System.Globalization.CultureInfo.InvariantCulture, out decimal res))
            formularioMaterial.SaldoGramas = Math.Max(0, res);
    }

    private void UpdateValorPago(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        valorPagoFormatted = val;
        var clean = val.Replace(".", "").Replace(",", ".").Trim();
        if (decimal.TryParse(clean, System.Globalization.CultureInfo.InvariantCulture, out decimal res))
            formularioMaterial.ValorPago = Math.Max(0, res);
    }

    protected override async Task OnInitializedAsync()
    {
        usuarioId = await UsuarioCtx.GetUsuarioIdAsync();
        carregando = true;
        try
        {
            await CarregarMateriais();
        }
        catch (Exception)
        {
            erroCarregamento = true;
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task SalvarMaterial()
    {
        try
        {
            carregando = true;
            if (modoEdicao && formularioMaterial.Id > 0)
            {
                formularioMaterial.UsuarioId = usuarioId;
                await MaterialRepo.UpdateAsync(formularioMaterial);
            }
            else
            {
                if (formularioMaterial.SaldoGramas == 0)
                    formularioMaterial.SaldoGramas = formularioMaterial.PesoRoloGramas;

                formularioMaterial.UsuarioId = usuarioId;
                formularioMaterial.DataCadastro = DateTime.UtcNow;
                await MaterialRepo.AddAsync(formularioMaterial);
            }
            
            formularioMaterial = new Material(); 
            modoEdicao = false;
            pesoFormatted = "";
            saldoFormatted = "";
            valorPagoFormatted = "";
            await CarregarMateriais();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao salvar material: {ex.Message}");
            erroCarregamento = true;
        }
        finally 
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private void EditarMaterial(Material mat)
    {
        formularioMaterial = new Material
        {
            Id = mat.Id,
            Nome = mat.Nome,
            Cor = mat.Cor,
            PesoRoloGramas = mat.PesoRoloGramas,
            ValorPago = mat.ValorPago,
            SaldoGramas = mat.SaldoGramas,
            DataCadastro = mat.DataCadastro
        };
        pesoFormatted = mat.PesoRoloGramas.ToString("N0");
        saldoFormatted = mat.SaldoGramas.ToString("N2");
        valorPagoFormatted = mat.ValorPago.ToString("N2");
        modoEdicao = true;
    }

    private void CancelarEdicao()
    {
        formularioMaterial = new Material();
        pesoFormatted = "";
        saldoFormatted = "";
        valorPagoFormatted = "";
        modoEdicao = false;
    }

    private async Task ExcluirMaterial(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "Você deseja realmente deletar esse registro?");
        if (confirmado)
        {
            mensagemExclusao = null;
            try
            {
                await MaterialRepo.DeleteAsync(id, usuarioId);
            }
            catch (InvalidOperationException ex)
            {
                // Material em uso por orçamentos (FK RESTRICT): exibe aviso em vez de derrubar a tela
                mensagemExclusao = ex.Message;
            }
            await CarregarMateriais();
            StateHasChanged();
        }
    }

    private async Task CarregarMateriais()
    {
        materiais = await MaterialRepo.GetAllAsync(usuarioId);
        materiais = materiais.OrderByDescending(m => m.DataCadastro).ToList();
    }
}
