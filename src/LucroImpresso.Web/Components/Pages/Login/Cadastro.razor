@page "/cadastro"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>LucroImpresso | Criar Conta</PageTitle>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/dashboard", forceLoad: true);
        }
    }
}

<div class="login-container">
    <div class="brutal-login-card bg-white brutal-border p-4 p-md-5 brutal-shadow-lg">
        <!-- Topo com Ícone e Título -->
        <div class="text-center mb-4 pb-3 brutal-border-b">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary-container brutal-border-2 p-2 mb-2" style="width: 56px; height: 56px;">
                <span class="material-symbols-outlined fs-2 text-dark">person_add</span>
            </div>
            <h2 class="font-headline text-dark fw-black uppercase tracking-tight mb-1 fs-3">CRIAR NOVA CONTA</h2>
            <p class="font-body text-muted small fw-bold mb-0 text-uppercase">Comece a precificar suas impressões hoje</p>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4 brutal-border-2 p-3" style="background-color: #ffdad6; color: #990000; border-color: #cc0000;">
                <span class="material-symbols-outlined fs-5">error</span>
                <span class="font-headline small fw-bold">
                    @(System.Net.WebUtility.UrlDecode(Error))
                </span>
            </div>
        }

        <form action="/auth/cadastro" method="post">
            <AntiforgeryToken />
            
            <div class="mb-3">
                <label class="form-label text-dark fw-black small">
                    <span class="material-symbols-outlined fs-6 align-middle me-1">person</span>
                    NOME DE USUÁRIO
                </label>
                <input type="text" name="usuario" class="form-control" placeholder="Ex: maker_felipe" required minlength="3" maxlength="30" pattern="^[a-zA-Z0-9_.]+$" autocomplete="username" />
                <small class="text-muted fw-semibold" style="font-size: 0.75rem;">Mínimo 3 caracteres (letras, números, _ e ponto). Não pode começar/terminar com _ ou ponto.</small>
            </div>

            <div class="mb-3">
                <label class="form-label text-dark fw-black small">
                    <span class="material-symbols-outlined fs-6 align-middle me-1">mail</span>
                    E-MAIL
                </label>
                <input type="email" name="email" class="form-control" placeholder="Ex: seunome@email.com" required maxlength="100" autocomplete="email" />
                <small class="text-muted fw-semibold" style="font-size: 0.75rem;">Será usado para identificação e recuperação da conta.</small>
            </div>

            <div class="mb-3">
                <label class="form-label text-dark fw-black small">
                    <span class="material-symbols-outlined fs-6 align-middle me-1">lock</span>
                    SENHA
                </label>
                <div class="input-group-password">
                    <input type="password" name="senha" class="form-control" placeholder="Mínimo 8 caracteres" required minlength="8" maxlength="64" autocomplete="new-password" />
                    <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility(this)" title="Mostrar senha">
                        <span class="material-symbols-outlined">visibility</span>
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-dark fw-black small">
                    <span class="material-symbols-outlined fs-6 align-middle me-1">lock_reset</span>
                    CONFIRMAR SENHA
                </label>
                <div class="input-group-password">
                    <input type="password" name="confirmacaoSenha" class="form-control" placeholder="Repita a senha digitada" required minlength="8" maxlength="64" autocomplete="new-password" />
                    <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility(this)" title="Mostrar senha">
                        <span class="material-symbols-outlined">visibility</span>
                    </button>
                </div>
            </div>

            <!-- Requisitos de Senha (feedback visual) -->
            <div class="p-3 bg-surface-container brutal-border-2 mb-3">
                <span class="font-headline text-dark text-xs font-black uppercase d-block mb-2">
                    <span class="material-symbols-outlined fs-6 align-middle me-1">checklist</span>
                    REQUISITOS DA SENHA
                </span>
                <div class="row g-1" style="font-size: 0.73rem;">
                    <div class="col-6">
                        <span class="text-muted fw-semibold">✓ Mínimo 8 caracteres</span>
                    </div>
                    <div class="col-6">
                        <span class="text-muted fw-semibold">✓ 1 letra maiúscula (A-Z)</span>
                    </div>
                    <div class="col-6">
                        <span class="text-muted fw-semibold">✓ 1 letra minúscula (a-z)</span>
                    </div>
                    <div class="col-6">
                        <span class="text-muted fw-semibold">✓ 1 número (0-9)</span>
                    </div>
                    <div class="col-12">
                        <span class="text-muted fw-semibold">✓ 1 caractere especial (!@@#$%^&*?_-)</span>
                    </div>
                </div>
            </div>

            <!-- Aviso de Segurança / Criptografia -->
            <div class="p-3 bg-surface-container brutal-border-2 mb-4 d-flex align-items-start gap-2">
                <span class="material-symbols-outlined fs-5 text-dark mt-1">shield</span>
                <small class="text-dark fw-semibold" style="font-size: 0.75rem; line-height: 1.4;">
                    <strong>Segurança Ativa:</strong> Sua senha será protegida com hash criptográfico <strong>BCrypt</strong> e seus dados ficarão completamente isolados em ambiente exclusivo.
                </small>
            </div>

            <button type="submit" class="btn btn-yellow w-100 py-3 fs-5 mt-2">
                <span class="material-symbols-outlined fs-4">how_to_reg</span>
                CADASTRAR CONTA
            </button>
        </form>

        <div class="mt-4 pt-3 border-top text-center">
            <p class="font-body text-muted small fw-semibold mb-2">Já possui uma conta?</p>
            <a href="/login" class="btn btn-white w-100 py-2 fs-6 brutal-border-2 fw-bold text-dark font-headline text-uppercase">
                <span class="material-symbols-outlined fs-5 align-middle me-1">login</span>
                FAZER LOGIN
            </a>
        </div>

        <div class="text-center mt-3">
            <a href="/" class="font-headline text-dark fw-bold text-decoration-none small uppercase">
                ← Voltar para a Página Inicial
            </a>
        </div>
    </div>
</div>
