@page "/maquinas"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using LucroImpresso.Web.Models
@using LucroImpresso.Web.Interfaces
@using LucroImpresso.Web.Services
@inject IMaquinaRepository MaquinaRepo
@inject UsuarioContextService UsuarioCtx
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>LucroImpresso | Máquinas</PageTitle>

<div class="page-container" style="max-width: 1300px; margin: 0 auto; padding: 1.25rem 1.5rem;">
    <header class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 pb-3 brutal-border-b">
        <div>
            <div class="d-inline-flex align-items-center gap-2 bg-white brutal-border-2 px-3 py-1 mb-2">
                <span class="material-symbols-outlined text-dark fs-5">precision_manufacturing</span>
                <span class="font-headline text-xs font-black uppercase text-dark">PARQUE DE IMPRESSORAS</span>
            </div>
            <h1 class="font-headline text-dark fw-black mb-0 display-6 uppercase tracking-tight">GESTÃO DE MÁQUINAS</h1>
            <p class="font-body text-muted fs-6 mt-1 mb-0 fw-semibold">Gerenciamento do parque de máquinas 3D e cálculo de custos de energia elétrica por hora.</p>
        </div>
    </header>

    @if (erroCarregamento)
    {
        <div class="alert alert-danger mb-4">
            <span class="material-symbols-outlined me-2 fs-5">error</span>
            Falha na conexão com o banco de dados. Verifique o serviço SQL.
        </div>
    }

    @if (!string.IsNullOrEmpty(mensagemExclusao))
    {
        <div class="alert alert-danger mb-4">
            <span class="material-symbols-outlined me-2 fs-5">error</span>
            @mensagemExclusao
        </div>
    }

    <!-- Topo: Master-Detail Form Neo-Brutalista -->
    <div class="bg-white brutal-border p-4 p-md-5 mb-5 brutal-shadow-lg">
        <div class="d-flex align-items-center justify-content-between pb-3 border-bottom brutal-border-b mb-4">
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-dark fs-3">precision_manufacturing</span>
                <h3 class="font-headline fw-black text-dark uppercase mb-0 fs-4">
                    @(modoEdicao ? "EDITAR MÁQUINA" : "CADASTRAR NOVA MÁQUINA")
                </h3>
            </div>
            @if (modoEdicao)
            {
                <span class="badge bg-warning text-dark">MODO EDIÇÃO</span>
            }
        </div>
        
        <EditForm Model="@formularioMaquina" OnValidSubmit="SalvarMaquina" FormName="formMaquina">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small mb-3 fw-bold font-headline" />
            
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-dark">Nome da Máquina</label>
                    <InputText @bind-Value="formularioMaquina.Nome" class="form-control" placeholder="Ex: Bambu Lab P1S" maxlength="100" />
                    <ValidationMessage For="@(() => formularioMaquina.Nome)" class="text-danger fw-bold small" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-dark">Potência de Consumo</label>
                    <div class="input-group">
                        <input type="text" 
                               class="form-control" 
                               placeholder="Ex: 350" 
                               oninput="window.masks.weight(this)"
                               @onchange="UpdatePotencia"
                               value="@potenciaFormatted"
                               maxlength="7" />
                        <span class="input-group-text">W</span>
                    </div>
                    <ValidationMessage For="@(() => formularioMaquina.ConsumoWatts)" class="text-danger fw-bold small" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-dark">Custo por kWh</label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input type="text" 
                               class="form-control" 
                               placeholder="Ex: 0,95" 
                               oninput="window.masks.money(this)"
                               @onchange="UpdateKwh"
                               value="@kwhFormatted"
                               maxlength="10" />
                    </div>
                    <ValidationMessage For="@(() => formularioMaquina.CustoKwh)" class="text-danger fw-bold small" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-yellow w-100 py-3 fs-6" disabled="@carregando">
                        @if (carregando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>AGUARDE...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined fs-5">@(modoEdicao ? "save" : "add_circle")</span>
                            @((modoEdicao ? "ATUALIZAR" : "SALVAR"))
                        }
                    </button>
                </div>
            </div>
            @if (modoEdicao)
            {
                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-outline-danger py-2 px-4" @onclick="CancelarEdicao">
                        ✕ CANCELAR EDIÇÃO
                    </button>
                </div>
            }
        </EditForm>
    </div>

    <!-- Base: Tabela de Máquinas -->
    <div class="bg-white brutal-border p-4 brutal-shadow-lg">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom brutal-border-b">
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-dark fs-4">dns</span>
                <h4 class="font-headline fw-black text-dark uppercase mb-0 fs-5">MÁQUINAS CADASTRADAS</h4>
            </div>
            <span class="badge bg-warning text-dark">@(maquinas.Count) MÁQUINAS</span>
        </div>

        @if (carregando && !maquinas.Any())
        {
            <div class="text-center py-5">
                <div class="spinner-border text-dark" role="status"></div>
                <p class="font-headline text-dark fw-bold mt-2 uppercase">Sincronizando banco de dados...</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table brutal-table text-dark mb-0">
                    <thead>
                        <tr>
                            <th>DATA CADASTRO</th>
                            <th>NOME DA MÁQUINA</th>
                            <th>POTÊNCIA (WATTS)</th>
                            <th>CUSTO (KWH)</th>
                            <th class="text-center">AÇÕES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (maquinas == null)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4 font-headline fw-bold">Carregando o sistema...</td></tr>
                        }
                        else if (!maquinas.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4 font-headline fw-bold">Nenhuma máquina cadastrada no momento.</td></tr>
                        }
                        else
                        {
                            @foreach (var maq in maquinas)
                            {
                                <tr>
                                    <td><span class="font-body text-dark fw-semibold">@maq.DataCadastro.ToString("dd/MM/yyyy")</span></td>
                                    <td><strong class="font-headline text-dark fs-6">@maq.Nome</strong></td>
                                    <td><span class="badge bg-warning text-dark">@maq.ConsumoWatts.ToString("N0") W</span></td>
                                    <td><strong class="font-headline text-dark fs-6">@maq.CustoKwh.ToString("C2")</strong></td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button class="btn btn-outline-warning btn-sm" @onclick="() => EditarMaquina(maq)">
                                                <span class="material-symbols-outlined fs-6">edit</span>
                                                Editar
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ExcluirMaquina(maq.Id)">
                                                <span class="material-symbols-outlined fs-6">delete</span>
                                                Excluir
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private string? mensagemExclusao;
    private List<Maquina> maquinas = new();
    private Maquina formularioMaquina = new();
    private bool erroCarregamento = false;
    private bool modoEdicao = false;
    private bool carregando = false;
    private int usuarioId = 0;

    private string potenciaFormatted = "";
    private string kwhFormatted = "";

    private void UpdatePotencia(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        potenciaFormatted = val;
        var clean = val.Replace(".", "").Replace(",", ".");
        if (decimal.TryParse(clean, System.Globalization.CultureInfo.InvariantCulture, out decimal res))
            formularioMaquina.ConsumoWatts = Math.Max(0, res);
    }

    private void UpdateKwh(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        kwhFormatted = val;
        var clean = val.Replace(".", "").Replace(",", ".").Trim();
        if (decimal.TryParse(clean, System.Globalization.CultureInfo.InvariantCulture, out decimal res))
            formularioMaquina.CustoKwh = Math.Max(0, res);
    }

    protected override async Task OnInitializedAsync()
    {
        usuarioId = await UsuarioCtx.GetUsuarioIdAsync();
        carregando = true;
        try
        {
            await CarregarMaquinas();
        }
        catch (Exception)
        {
            erroCarregamento = true;
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task SalvarMaquina()
    {
        try
        {
            carregando = true;
            if (modoEdicao && formularioMaquina.Id > 0)
            {
                formularioMaquina.UsuarioId = usuarioId;
                await MaquinaRepo.UpdateAsync(formularioMaquina);
            }
            else
            {
                formularioMaquina.UsuarioId = usuarioId;
                formularioMaquina.DataCadastro = DateTime.UtcNow;
                await MaquinaRepo.AddAsync(formularioMaquina);
            }
            
            formularioMaquina = new Maquina(); 
            modoEdicao = false;
            potenciaFormatted = "";
            kwhFormatted = "";
            await CarregarMaquinas();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao salvar máquina: {ex.Message}");
            erroCarregamento = true;
        }
        finally 
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private void EditarMaquina(Maquina maq)
    {
        formularioMaquina = new Maquina
        {
            Id = maq.Id,
            Nome = maq.Nome,
            ConsumoWatts = maq.ConsumoWatts,
            CustoKwh = maq.CustoKwh,
            DataCadastro = maq.DataCadastro
        };
        potenciaFormatted = maq.ConsumoWatts.ToString("N0");
        kwhFormatted = maq.CustoKwh.ToString("N2");
        modoEdicao = true;
    }

    private void CancelarEdicao()
    {
        formularioMaquina = new Maquina();
        potenciaFormatted = "";
        kwhFormatted = "";
        modoEdicao = false;
    }

    private async Task ExcluirMaquina(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "Você deseja realmente deletar esse registro?");
        if (confirmado)
        {
            mensagemExclusao = null;
            try
            {
                await MaquinaRepo.DeleteAsync(id, usuarioId);
            }
            catch (InvalidOperationException ex)
            {
                // Máquina em uso por orçamentos (FK RESTRICT): exibe aviso em vez de derrubar a tela
                mensagemExclusao = ex.Message;
            }
            await CarregarMaquinas();
            StateHasChanged();
        }
    }

    private async Task CarregarMaquinas()
    {
        maquinas = await MaquinaRepo.GetAllAsync(usuarioId);
        maquinas = maquinas.OrderByDescending(m => m.DataCadastro).ToList();
    }
}
