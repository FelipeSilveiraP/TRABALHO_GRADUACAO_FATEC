@startuml
title Diagrama Geral de Casos de Uso - Sistema LucroImpresso

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam monochrome false

actor "Empreendedor" as Emp
actor "Software Fatiador\n<<Ferramenta Externa>>" as Fat
actor "Sistema (Timer /\nBackground Service)" as Sys

rectangle "Sistema LucroImpresso" {

  package "Módulo 1: Autenticação e Configurações" {
    usecase "UC01: Realizar Login" as UC01
    usecase "UC02: Alterar Nome de Usuário" as UC02
    usecase "UC03: Alterar Senha de Acesso" as UC03
    usecase "UC04: Cadastrar Nova Conta (Sign-Up)" as UC04
    usecase "UC05: Recuperar Senha via E-mail" as UC05
  }

  package "Módulo 2: Cadastros Base (Peças, Máquinas, Clientes)" {
    usecase "UC06: Cadastrar Peça (com link STL)" as UC06
    usecase "UC07: Consultar Peças" as UC07
    usecase "UC08: Editar / Excluir Peça" as UC08

    usecase "UC09: Cadastrar Máquina (Watts e Tarifa de Energia)" as UC09
    usecase "UC10: Consultar Máquinas" as UC10
    usecase "UC11: Editar / Excluir Máquina" as UC11

    usecase "UC12: Cadastrar Cliente (PF ou PJ)" as UC12
    usecase "UC13: Consultar Clientes" as UC13
    usecase "UC14: Editar / Excluir Cliente" as UC14
  }

  package "Módulo 3: Gestão de Estoque e Materiais" {
    usecase "UC15: Cadastrar Matéria-Prima (Filamento/Resina)" as UC15
    usecase "UC16: Cadastrar Insumo de Acabamento (mL)" as UC16
    usecase "UC17: Consultar Estoque e Alertas Críticos" as UC17
    usecase "UC18: Editar / Excluir Insumos de Estoque" as UC18
  }

  package "Módulo 4: Orçamentos e Precificação" {
    usecase "UC19: Gerar Novo Orçamento com Custos Detalhados" as UC19
    usecase "UC20: Alertar Estoque Insuficiente" as UC20
    usecase "UC21: Editar Orçamento Existente" as UC21
    usecase "UC22: Excluir Orçamento com Preservação Histórica" as UC22
  }

  package "Módulo 5: Fila Operacional e Produção" {
    usecase "UC23: Alterar Status da Ordem de Produção" as UC23
    usecase "UC24: Registrar Orçamento como Concluído" as UC24
    usecase "UC25: Registrar Falha de Impressão" as UC25
    usecase "UC26: Deduzir Estoque de Materiais e Acabamentos" as UC26
  }

  package "Módulo 6: Dashboard Financeiro e Background Job" {
    usecase "UC27: Visualizar Painel Operacional (Receitas, Despesas e Caixa)" as UC27
    usecase "UC28: Varrer e Excluir Orçamentos Antigos (> 180 dias)" as UC28
  }
}

' Relacionamentos - Empreendedor
Emp --> UC01
Emp --> UC02
Emp --> UC03
Emp --> UC04
Emp --> UC05

Emp --> UC06
Emp --> UC07
Emp --> UC08

Emp --> UC09
Emp --> UC10
Emp --> UC11

Emp --> UC12
Emp --> UC13
Emp --> UC14

Emp --> UC15
Emp --> UC16
Emp --> UC17
Emp --> UC18

Emp --> UC19
Emp --> UC21
Emp --> UC22

Emp --> UC23
Emp --> UC24
Emp --> UC25

Emp --> UC27

' Relacionamentos Externos e de Inclusão/Extensão
Fat --> UC19 : "Fornece peso (g)\ne tempo (h)"
UC20 ..> UC19 : <<estende>>

UC24 ..> UC26 : <<inclui>>
UC25 ..> UC26 : <<inclui>>

Sys --> UC28

@enduml
